rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function employeeDoc() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && employeeDoc().data.active == true
        && employeeDoc().data.role in ['attendant', 'manager', 'admin'];
    }

    match /employees/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /customers/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true
        && request.resource.data.points == 0;

      allow read: if signedIn() && (request.auth.uid == userId || isEmployee());
      allow update, delete: if false;

      match /transactions/{transactionId} {
        allow read: if signedIn() && (request.auth.uid == userId || isEmployee());

        // Cliente só pode criar um débito de resgate próprio.
        allow create: if signedIn()
          && request.auth.uid == userId
          && transactionId == 'redeem_' + request.resource.data.couponId
          && request.resource.data.customerId == userId
          && request.resource.data.type == 'couponRedemption'
          && request.resource.data.points is int
          && request.resource.data.points < 0
          && request.resource.data.amount == 0;

        // Funcionário ativo só pode criar crédito de abastecimento no posto
        // vinculado ao seu cadastro interno.
        allow create: if isEmployee()
          && request.resource.data.customerId == userId
          && request.resource.data.type == 'fueling'
          && request.resource.data.operatorId == request.auth.uid
          && request.resource.data.stationId == employeeDoc().data.stationId
          && request.resource.data.stationName == employeeDoc().data.stationName
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= request.resource.data.amount
          && (request.resource.data.liters == null || request.resource.data.liters is number);

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
